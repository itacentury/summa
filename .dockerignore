# Git
.git/
.gitignore
.gitattributes

# Frontend tooling (no build step — only lint/format config)
node_modules/
package.json
package-lock.json
eslint.config.js
.stylelintrc.json
.prettierrc.json
.prettierignore

# Not needed at runtime
tests/
docs/
assets/
scripts/
# ...except the benchmark refresh the `benchmark` compose service runs
!scripts/__init__.py
!scripts/portfolio_db.py
!scripts/fetch_benchmark.py
.claude/

# Docker itself (not part of the image)
Dockerfile
docker-compose.yml
.dockerignore

# Python cache
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Virtual environments
.env
.venv/
env/
venv/

# IDE
.idea/
.vscode/
*.code-workspace

# Database (use volume mount instead)
*.db
*.sqlite
*.sqlite3

# Documentation
*.md
LICENSE

# CI/CD
.github/

