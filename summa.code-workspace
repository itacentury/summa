{
  "folders": [
    {
      "path": ".",
    },
  ],
  "settings": {
    "task.autoDetect": "off",
    "python.terminal.activateEnvironment": true,
    "python.analysis.typeCheckingMode": "standard",
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.formatOnSave": true,
      "editor.formatOnPaste": true,
      "editor.tabSize": 4,
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit",
      },
    },
    "[html]": {
      "editor.defaultFormatter": "vscode.html-language-features",
    },
    "[javascript][css]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true,
      "editor.formatOnPaste": true,
      "editor.tabSize": 2,
      "editor.insertSpaces": true,
    },
    "[markdown]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true,
      "editor.formatOnPaste": true,
      "editor.wordWrap": "on",
      "editor.unicodeHighlight.ambiguousCharacters": true,
      "editor.unicodeHighlight.invisibleCharacters": true,
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.trimAutoWhitespace": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.associations": {
      "*.html": "jinja-html",
    },
    "emmet.includeLanguages": {
      "jinja-html": "html",
    },
    "files.exclude": {
      "**/__pycache__": true,
      "**/.mypy_cache": true,
      "**/.ruff_cache": true,
      "**/*.pyc": true,
      "**/.venv": true,
      ".git": true,
      "**/.pytest_cache": true,
      "**/node_modules": true,
    },
    "search.exclude": {
      "**/__pycache__": true,
      "**/.mypy_cache": true,
      "**/.ruff_cache": true,
      "**/*.pyc": true,
      "**/.venv": true,
      ".git": true,
      "**/.pytest_cache": true,
      "**/node_modules": true,
    },
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Format: All",
        "type": "shell",
        "command": "uv run ruff check --fix . && uv run ruff format . && npm run fix",
        "group": "build",
        "presentation": {
          "panel": "shared",
        },
      },
      {
        "label": "Lint: All",
        "type": "shell",
        "command": "uv run ruff check . && uv run mypy . && npm run lint",
        "group": "build",
        "presentation": {
          "panel": "shared",
          "clear": true,
        },
      },
      {
        "label": "Test: All",
        "type": "shell",
        "command": "uv run pytest && npm run test",
        "group": "build",
        "presentation": {
          "panel": "shared",
          "clear": true,
        },
      },
      {
        "label": "Run: Start Server",
        "type": "shell",
        "command": "uv run --env-file .env flask --app summa.wsgi run --debug --port 8000",
        "group": "build",
        "isBackground": true,
        "presentation": {
          "panel": "dedicated",
        },
      },
      {
        "label": "Docker: Build",
        "type": "shell",
        "command": "docker compose build",
        "group": "build",
      },
      {
        "label": "Docker: Up",
        "type": "shell",
        "command": "docker compose up -d",
        "group": "build",
      },
      {
        "label": "Docker: Down",
        "type": "shell",
        "command": "docker compose down",
      },
    ],
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Flask: Run App",
        "type": "debugpy",
        "request": "launch",
        "module": "flask",
        "args": ["run", "--debug", "--port", "8000"],
        "env": {
          "FLASK_APP": "summa.wsgi",
          "FLASK_DEBUG": "1",
        },
        "envFile": "${workspaceFolder}/.env",
        "jinja": true,
      },
      {
        "name": "Python: Current File",
        "type": "debugpy",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal",
      },
    ],
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff",
      "ms-python.mypy-type-checker",
      "samuelcolvin.jinjahtml",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "stylelint.vscode-stylelint",
      "ms-azuretools.vscode-docker",
      "GitHub.vscode-github-actions",
    ],
  },
}
