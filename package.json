{
  "name": "summa-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend lint and format toolchain for the Summa PWA.",
  "type": "module",
  "scripts": {
    "lint:js": "eslint .",
    "lint:css": "stylelint \"static/**/*.css\"",
    "lint:headings": "node scripts/check-heading-levels.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "eslint . --fix && stylelint \"static/**/*.css\" --fix && prettier --write .",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:headings && npm run format:check",
    "test": "cross-env TZ=Europe/Berlin vitest run",
    "test:watch": "cross-env TZ=Europe/Berlin vitest",
    "screenshots:setup": "npm ci --prefix scripts/screenshots && npm run install-browser --prefix scripts/screenshots",
    "screenshots": "npm run capture --prefix scripts/screenshots"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.62.0",
    "@html-eslint/parser": "^0.62.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.8.4",
    "prettier-plugin-jinja-template": "^2.2.0",
    "stylelint": "^17.13.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^4.0.18"
  }
}
