# Master switch for AI-powered category suggestions. If this variable is missing,
# the feature is disabled by default. Keep this at 1 to enable it explicitly, or
# set to 0 to hide the trigger and hard-disable the feature.
ENABLE_AI_SUGGESTIONS=1

# Enables AI-powered category suggestions. Get a key at https://console.anthropic.com/
# Leave empty to keep the trigger visible while requests return "not configured".
ANTHROPIC_API_KEY=

# Path to the SQLite database file. Docker uses the image default /data/invoices.db
# (persisted in the ./data bind mount) — leave this commented there. For local dev,
# uncomment to place the DB under ./data instead of the repo root.
# DATABASE_PATH=data/invoices.db

# CORS allowlist for cross-origin clients. Empty = same-origin only, "*" = wildcard,
# otherwise a comma-separated list of origins.
CORS_ALLOWED_ORIGINS=

# Set to 1 to enable the Werkzeug debugger on the dev server. Never in production.
FLASK_DEBUG=0

# Master switch for the single-password login gate. Missing or 0 leaves the app
# open to anyone who can reach it.
AUTH_ENABLED=0

# Hash of the login password — the app never accepts a plaintext one. Generate
# with: uv run python -m summa.hashpw
AUTH_PASSWORD_HASH=

# Key used to sign the session cookie. Required once the gate is enabled; without
# it every restart (and every gunicorn worker) invalidates existing sessions.
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# How long "Stay signed in" keeps a session alive, in days. Accepts 1-3650;
# anything else (including a non-number) falls back to 30.
SESSION_DAYS=30

# Set to 0 for local plain-HTTP testing — a Secure cookie is dropped over http://
# and login then appears to succeed while every later request is rejected. Keep
# it at 1 behind a TLS-terminating proxy.
COOKIE_SECURE=1
# Keeping this at `lax` is what defends against CSRF; there is no CSRF token. Set
# `none` only for a cross-origin browser client, and only with COOKIE_SECURE=1 —
# browsers drop a SameSite=None cookie that is not Secure.
COOKIE_SAMESITE=lax
